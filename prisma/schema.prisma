// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String      @id @default(cuid())
  username      String      @unique
  email         String?     @unique
  emailVerified DateTime?
  themePreference String?   @default("system")
  password      String
  role          Role        @default(STAFF)
  accounts      Account[]
  sessions      Session[]
  requests      Request[]
  auditLogs     AuditLog[]
  authTokens    AuthToken[]
  notifications Notification[]
  vendorReorders VendorReorder[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Supply {
  id               String       @id @default(cuid())
  name             String
  description      String
  quantity         Int          @default(0)
  minimumThreshold Int          @default(0)
  barcode          String?      @unique
  internalSku      String?      @unique
  itemTypeId       String?
  itemType         ItemType?    @relation(fields: [itemTypeId], references: [id])
  requests         Request[]
  stockLevels      StockLevel[]
  itemVendors      ItemVendor[]
  stockMovements   StockMovement[]
  vendorReorders   VendorReorder[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([name])
}

model Request {
  id        String        @id @default(cuid())
  userId    String
  supplyId  String
  quantity  Int
  status    RequestStatus @default(PENDING)
  user      User         @relation(fields: [userId], references: [id])
  supply    Supply       @relation(fields: [supplyId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuthToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String?
  email     String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model AuthAttempt {
  id          String    @id @default(cuid())
  identifier  String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
}

model Location {
  id             String          @id @default(cuid())
  name           String          @unique
  type           String
  description    String?
  isActive       Boolean         @default(true)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ItemType {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  attributes  Json     @default("{}")
  supplies    Supply[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockLevel {
  id               String   @id @default(cuid())
  supplyId         String
  locationId       String
  quantity         Int      @default(0)
  minimumThreshold Int      @default(0)
  supply           Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([supplyId, locationId])
  @@index([locationId])
}

model Vendor {
  id          String       @id @default(cuid())
  name        String
  contact     String?
  website     String?
  notes       String?
  isActive    Boolean      @default(true)
  itemVendors ItemVendor[]
  vendorReorders VendorReorder[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ItemVendor {
  id            String   @id @default(cuid())
  supplyId      String
  vendorId      String
  vendorSku     String?
  internalSku   String?
  isPreferred   Boolean  @default(false)
  leadTimeDays  Int?
  moq           Int?
  cost          Decimal? @db.Decimal(10, 2)
  supply        Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([supplyId, vendorId])
}

model StockMovement {
  id              String            @id @default(cuid())
  supplyId        String
  locationId      String
  quantity        Int
  type            StockMovementType
  badgeId         String?
  userId          String?
  notes           String?
  vendorReorderId String?
  supply          Supply            @relation(fields: [supplyId], references: [id])
  location        Location          @relation(fields: [locationId], references: [id])
  vendorReorder   VendorReorder?    @relation(fields: [vendorReorderId], references: [id])
  attachments     FileAttachment[]
  createdAt       DateTime          @default(now())

  @@index([supplyId, createdAt])
  @@index([locationId])
  @@index([vendorReorderId])
}

model VendorReorder {
  id               String              @id @default(cuid())
  supplyId         String
  vendorId         String?
  quantity         Int
  externalPoNumber String?
  status           VendorReorderStatus @default(ORDERED)
  orderedAt        DateTime            @default(now())
  receivedAt       DateTime?
  notes            String?
  createdById      String
  supply           Supply              @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  vendor           Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy        User                @relation(fields: [createdById], references: [id])
  stockMovements   StockMovement[]
  attachments      FileAttachment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([supplyId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model FileAttachment {
  id              String         @id @default(cuid())
  supplyId        String?
  stockMovementId String?
  vendorReorderId String?
  filename        String
  mimeType        String
  size            Int
  data            Bytes?
  storageKey      String?
  category        String
  uploadedById    String
  createdAt       DateTime       @default(now())
  stockMovement   StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)
  vendorReorder   VendorReorder? @relation(fields: [vendorReorderId], references: [id], onDelete: Cascade)

  @@index([supplyId])
  @@index([stockMovementId])
  @@index([vendorReorderId])
}

enum StockMovementType {
  CONSUME
  RECEIVE
  ADJUST
  TRANSFER
}

enum NotificationType {
  LOW_STOCK
  REORDER
  REQUEST_STATUS
  SYSTEM
  USER_REGISTRATION
}

enum Role {
  ADMIN
  STAFF
  PENDING
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum VendorReorderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
}
