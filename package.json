{
  "name": "supli",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "npx prisma migrate deploy && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "ts-node -T prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node -T prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.0.0",
    "@prisma/client": "^5.0.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.0.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.17",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.356.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.0.0",
    "recharts": "^2.13.3",
    "resend": "^6.17.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.2.0",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.10",
    "prettier": "^3.4.2",
    "prisma": "^5.0.0",
    "tailwindcss": "^3.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10",
    "yargs": "^17.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "postcss": "^8.5.10",
    "tar": "^7.5.16",
    "uuid": "^11.1.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    },
    "@next/eslint-plugin-next": {
      "glob": "^11.1.0"
    }
  }
}
