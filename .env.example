# --- Database (onsite-first) ---
# Works for Docker Compose Postgres OR bare-metal Postgres on the host.
# Create the role/DB with: npm run db:host-setup   OR   docker compose up -d
DATABASE_URL="postgresql://supli:supli@localhost:5432/supli?sslmode=disable"

# Cloud / edge (Neon, etc.) — only if you deploy remotely:
# DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Integration tests — separate database (never use production)
# Local: npm run test:db:up then use:
DATABASE_TEST_URL="postgresql://supli:supli@localhost:5433/supli_test"

# NextAuth / Auth.js — generate secret with: openssl rand -base64 32
# AUTH_SECRET is preferred by Auth.js v5; NEXTAUTH_* aliases still work.
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_URL="http://localhost:3000"

# Superadmin bootstrap (optional) — never commit real credentials
# If the email already exists, that user is promoted to SUPERADMIN (siteId cleared).
# If not, SUPERADMIN_INITIAL_PASSWORD is required to create the account.
# SUPERADMIN_EMAIL="you@example.com"
# SUPERADMIN_INITIAL_PASSWORD="ChangeMeImmediately1"

# Email (Resend) — optional onsite. Without keys, invite/reset/alerts are logged and skipped.
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Supli Mart <noreply@yourdomain.com>"

# Storage — optional / legacy (inbound attachments are stored in Postgres by default)
# STORAGE_PROVIDER="local"
# STORAGE_LOCAL_PATH="./uploads"

# Cloudflare R2 (S3-compatible) — optional supply item images.
# Bucket must be PRIVATE (no public r2.dev / custom domain). The app serves
# images by proxying a short-lived signed GET through /api/supplies/:id/image.
# When these are unset, the app still runs: upload UI is hidden and placeholders show.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="xxxxxxxx"
# R2_SECRET_ACCESS_KEY="xxxxxxxx"
# R2_BUCKET="supli-images"
# Optional override for local MinIO / S3-compatible stand-ins:
# R2_ENDPOINT="http://127.0.0.1:9000"
#
# R2 bucket CORS (required for browser → R2 presigned PUT). The browser upload
# sends ONLY the Content-Type header (Content-Length is set by the UA; no
# x-amz-checksum-* headers). Current private bucket policy shape:
# [
#   {
#     "AllowedOrigins": [
#       "http://localhost:3000",
#       "http://127.0.0.1:3000"
#     ],
#     "AllowedMethods": ["PUT", "GET", "HEAD"],
#     "AllowedHeaders": ["Content-Type"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3600
#   }
# ]
# Add your production app origin to AllowedOrigins when deploying (Koyeb/public URL).

# Proxy hostnames for server actions (Cloudflare / Koyeb edge), comma-separated
# SERVER_ACTIONS_ALLOWED_ORIGINS="app.example.com"
